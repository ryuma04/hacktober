# shared
DATA_DIR=./data
# Go API
PORT=8080
AI_SERVICE_URL=http://localhost:8001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_S=300
DEFAULT_REPO_URL=https://github.com/rishrek/LinkWatch
# AI service
# Comma-separated Google AI Studio keys; the next key is used automatically when one is exhausted/rejected.
GEMINI_API_KEYS=
# Tried in order; the next model is used when one is overloaded.
GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
GEMMA_TIMEOUT_S=120
GEMMA_MAX_CONCURRENCY=6
# Fallback LLM (xAI Grok), used only when every Gemma key/model fails. Comma-separated.
XAI_API_KEYS=
XAI_MODEL=
